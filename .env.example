# Copie este arquivo para .env na raiz antes de "docker compose up".
# O compose lê automaticamente o .env da raiz do projeto.

# OBRIGATÓRIO: segredo de assinatura dos JWTs. Gere com: openssl rand -hex 32
JWT_SECRET=

# Opcionais (defaults abaixo):
MARIADB_ROOT_PASSWORD=rootsecret
MARIADB_DATABASE=ticket_triage
MARIADB_USER=app
MARIADB_PASSWORD=appsecret

# Origens extras permitidas por CORS, separadas por vírgula (ex.: http://localhost:5173).
# Vazio = same-origin apenas (o padrão quando acessa pela web :8080).
CORS_ORIGIN=
