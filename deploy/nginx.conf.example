# Site Nginx do Ticket Triage — publicado automaticamente pelo scripts/deploy.sh,
# que substitui __APP_DIR__ e __API_PORT__ pelos valores reais da VPS.

server {
    listen 80;
    server_name afl.brazil.vps-kinghost.net;
    client_max_body_size 100M;

    root __APP_DIR__/frontend/dist;
    index index.html;

    gzip on;
    gzip_min_length 256;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Assets do Vite têm hash no nome: cache longo é seguro.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # API no PM2 — mantém o prefixo /api (setGlobalPrefix do Nest) e ajusta
    # buffering/timeout para o SSE (/api/queue/events).
    location /api/ {
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # SPA
    location / {
        try_files $uri $uri/ /index.html;
    }
}
