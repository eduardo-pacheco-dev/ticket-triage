# Exemplo de site Nginx para o Ticket Triage.
# Copie para /etc/nginx/sites-available/ticket-triage e crie o link: sudo ln -s /etc/nginx/sites-available/ticket-triage /etc/nginx/sites-enabled/
#
# Frontend: arquivos estáticos de frontend/dist (SPA com fallback para index.html).
# API: proxy para PM2 em 127.0.0.1:3000, com ajustes para SSE (/api/queue/events).

server {
    listen 80;
    server_name afl.vps-kinghost.net;

    root /var/www/app/ticket-triage/frontend/dist;
    index index.html;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Assets do Vite têm hash no nome: cache longo é seguro.
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # API (inclui SSE: sem buffering e timeout alto para conexões longas).
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # SPA
    location / {
        try_files $uri $uri/ /index.html;
    }
}
