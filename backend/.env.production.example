# Exemplo de backend/.env para PRODUÇÃO (VPS).
# Copie para backend/.env e preencha os valores reais.

PORT=3000

# Produção exige DB_SYNC=false; as tabelas são criadas por migrations.
DB_SYNC=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ticket_triage
DB_USER=app
DB_PASSWORD=troque-esta-senha

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Usuário inicial criado pelo seed (npm run db:seed). Remova/troque após o primeiro acesso.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=troque-esta-senha

# Frontend é servido pelo mesmo domínio via Nginx (same-origin): deixe vazio.
# Só preencha se o frontend for servido de outro domínio/porta.
CORS_ORIGIN=
