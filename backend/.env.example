PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=ticket_triage
DB_USER=app
DB_PASSWORD=appsecret
# Somente em desenvolvimento. Em produção use migrations (DB_SYNC=false).
DB_SYNC=true

# Obrigatório em produção (NODE_ENV=production) — o boot falha sem ele.
JWT_SECRET=generate-a-strong-secret
# Origens permitidas para CORS, separadas por vírgula. Vazio em produção = same-origin apenas.
CORS_ORIGIN=http://localhost:5173

SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=admin
